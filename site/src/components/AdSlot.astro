---
/**
 * An advertising slot.
 *
 * Renders **nothing** unless both the publisher id and the unit id are
 * configured, and nothing on a legal page whatever the caller asks. When it
 * renders, it takes no room and shows no label until Google has actually
 * filled it: an unfilled or blocked slot stays collapsed. It is pushed only
 * when it comes within about 600px of the viewport (public/privacy.js, the
 * runtime shared by the DynShift sites), so it fills below the reader rather
 * than under them, and carries restricted data processing when the browser
 * sends Global Privacy Control.
 *
 * Where these may appear is a decision, not a default: documentation,
 * troubleshooting and the guides, one per page. Never on the download path,
 * never between the steps of an installation, never on a legal page, never
 * anywhere a reader might mistake one for part of the page.
 */
import { ADSENSE_CLIENT, ADSENSE_SLOT } from "../consts";

interface Props {
  /** AdSense ad-unit id. Defaults to the configured unit; without one there
   *  is nothing to render. */
  slot?: string;
  label?: string;
}
const { slot = ADSENSE_SLOT, label = "Advertisement" } = Astro.props as Props;
const legal = /^\/(privacy|cookies|terms|contact)(\/|$)/.test(Astro.url.pathname);
const show = Boolean(ADSENSE_CLIENT && slot) && !legal;
---

{
  show && (
    <aside class="ad" data-ad-slot-lazy aria-label={label}>
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    </aside>
  )
}

<style>
  /* Nothing at all until Google fills the slot; the rule and the label come
     with the advertisement. */
  .ad {
    display: block;
  }
  .ad-label {
    display: none;
  }
  .ad:has(ins[data-ad-status="filled"]) {
    margin: 3rem 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .ad:has(ins[data-ad-status="filled"]) .ad-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink3);
    margin-bottom: 10px;
  }
  .ad:has(ins[data-ad-status="unfilled"]) {
    display: none;
  }
</style>

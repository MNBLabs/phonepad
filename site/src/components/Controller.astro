---
/**
 * The on-screen controller, drawn as SVG.
 *
 * The controller *is* the product's visual identity, so the hero shows the real
 * thing rather than a stock illustration or a photograph of a phone. Drawn
 * rather than screenshotted because it has to stay crisp at any width, load
 * instantly, and — the part a screenshot cannot do — move.
 *
 * Geometry, proportions and the monochrome outline-first treatment match
 * phone/lib/ui/controller_painter.dart. If that changes, this should follow.
 * The controller carries no colour of its own: it is white at varying alpha
 * over night, exactly as on the phone.
 */
interface Props {
  animate?: boolean;
}
const { animate = false } = Astro.props as Props;
---

<svg
  class:list={["pad", animate && "pad-live"]}
  viewBox="0 0 832 384"
  role="img"
  aria-label="The PhonePad on-screen controller: two sticks, a D-pad, four face buttons, shoulder buttons and analogue triggers"
>
  <rect width="832" height="384" rx="26" fill="var(--night)"></rect>

  <g class="ctl">
    <!-- triggers and shoulders -->
    <rect x="47" y="41" width="47" height="71" rx="16"></rect>
    <rect x="738" y="41" width="47" height="71" rx="16"></rect>
    <rect x="147" y="19" width="81" height="38" rx="19"></rect>
    <rect x="604" y="19" width="81" height="38" rx="19"></rect>

    <!-- guide, view, menu -->
    <circle cx="416" cy="38" r="14"></circle>
    <circle cx="370" cy="92" r="12"></circle>
    <circle cx="462" cy="92" r="12"></circle>

    <!-- d-pad: a diagonal cross under the cardinal one, the construction of
         the mark, and what an eight-way pad is -->
    <path class="diag" transform="rotate(45 308.5 272)" d="M306.0 231.6 h5.1 a4.4 4.4 0 0 1 4.4 4.4 v29.1 h29.1 a4.4 4.4 0 0 1 4.4 4.4 v5.1 a4.4 4.4 0 0 1 -4.4 4.4 h-29.1 v29.1 a4.4 4.4 0 0 1 -4.4 4.4 h-5.1 a4.4 4.4 0 0 1 -4.4 -4.4 v-29.1 h-29.1 a4.4 4.4 0 0 1 -4.4 -4.4 v-5.1 a4.4 4.4 0 0 1 4.4 -4.4 h29.1 v-29.1 a4.4 4.4 0 0 1 4.4 -4.4 z"></path>
    <path d="M305.0 225.0 h7.0 a7 7 0 0 1 7 7 v29.5 h29.5 a7 7 0 0 1 7 7 v7.0 a7 7 0 0 1 -7 7 h-29.5 v29.5 a7 7 0 0 1 -7 7 h-7.0 a7 7 0 0 1 -7 -7 v-29.5 h-29.5 a7 7 0 0 1 -7 -7 v-7.0 a7 7 0 0 1 7 -7 h29.5 v-29.5 a7 7 0 0 1 7 -7 z"></path>
    <rect class="construct-fill" x="306.8" y="270.3" width="3.4" height="3.4"></rect>

    <!-- face buttons -->
    <circle cx="520" cy="169" r="22"></circle>
    <circle cx="453" cy="238" r="22"></circle>
    <circle cx="587" cy="238" r="22"></circle>
    <circle cx="520" cy="307" r="22"></circle>

    <!-- stick clicks -->
    <circle cx="46" cy="169" r="12"></circle>
    <circle cx="786" cy="169" r="12"></circle>
  </g>

  <g class="lbl">
    <text x="70" y="82">LT</text>
    <text x="761" y="82">RT</text>
    <text x="187" y="45">LB</text>
    <text x="644" y="45">RB</text>
    <text x="520" y="176">Y</text>
    <text x="453" y="245">X</text>
    <text x="587" y="245">B</text>
    <text x="520" y="314">A</text>
  </g>

  <!-- sticks -->
  <g class="stick">
    <circle cx="146" cy="261" r="65" class="ring"></circle>
    <circle cx="146" cy="261" r="60" class="sat"></circle>
    <circle class="knob knob-l" cx="146" cy="261" r="26"></circle>
    <circle class="lip lip-l" cx="146" cy="261" r="16"></circle>
  </g>
  <g class="stick">
    <circle cx="686" cy="261" r="65" class="ring"></circle>
    <circle cx="686" cy="261" r="60" class="sat"></circle>
    <circle class="knob knob-r" cx="686" cy="261" r="26"></circle>
    <circle class="lip lip-r" cx="686" cy="261" r="16"></circle>
  </g>
</svg>

<style>
  .pad {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }

  .ctl rect,
  .ctl circle,
  .ctl path {
    fill: rgba(255, 255, 255, 0.08);
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 2;
  }
  .ctl .diag {
    fill: rgba(255, 255, 255, 0.06);
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 1.5;
  }
  .ctl .construct-fill {
    fill: rgba(255, 255, 255, 0.26);
    stroke: none;
  }

  .lbl text {
    fill: rgba(255, 255, 255, 0.72);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-anchor: middle;
  }

  .stick .ring {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 2;
  }
  .stick .sat {
    fill: none;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1;
  }
  .stick .knob {
    fill: rgba(255, 255, 255, 0.55);
  }
  .stick .lip {
    fill: none;
    stroke: rgba(0, 0, 0, 0.18);
    stroke-width: 1.2;
  }

  /*
   * A slow drift, not a demo loop. It says "these are analogue sticks that
   * follow your thumb" and then gets out of the way; a looping animation that
   * mimes playing a game would be a lie about what the page is showing.
   */
  .pad-live .knob-l,
  .pad-live .lip-l {
    animation: driftL 9s ease-in-out infinite;
  }
  .pad-live .knob-r,
  .pad-live .lip-r {
    animation: driftR 11s ease-in-out infinite;
  }

  @keyframes driftL {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(24px, -12px);
    }
    55% {
      transform: translate(-18px, 16px);
    }
    80% {
      transform: translate(9px, 20px);
    }
  }
  @keyframes driftR {
    0%,
    100% {
      transform: translate(0, 0);
    }
    30% {
      transform: translate(-20px, -18px);
    }
    60% {
      transform: translate(22px, 10px);
    }
    85% {
      transform: translate(-8px, 18px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pad-live .knob-l,
    .pad-live .knob-r,
    .pad-live .lip-l,
    .pad-live .lip-r {
      animation: none;
    }
  }
</style>

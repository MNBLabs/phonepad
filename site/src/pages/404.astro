---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page does not exist.">
  <section>
    <div class="wrap prose" style="padding-block:4rem">
      <h1 style="font-size:clamp(2rem,5vw,3rem)">That page does not exist</h1>
      <p class="lede">
        A link is wrong somewhere — possibly ours. Here is where things are:
      </p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/setup/">Setup guide</a></li>
        <li><a href="/troubleshooting/">Troubleshooting</a></li>
        <li><a href="/docs/">Documentation</a></li>
        <li><a href="/support/">Support</a></li>
      </ul>
    </div>
  </section>
</Base>
